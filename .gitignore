# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.Python
.venv/
venv/
env/

# OS / editor cruft
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*~
.ipynb_checkpoints/
*.ipynb_meta

# Retrieval indexes (rebuildable in minutes; ~570 MB combined)
# See README "Rebuilding retrieval indexes" for how to regenerate.
outputs/index/
outputs/index_*/

# Model weights (published to HuggingFace as ArgParser-v1..v4)
# We track only the small metadata: config.json, tokenizer.json,
# adapter_config.json, train.log, phase2_metrics.json, README.md.
models/**/*.safetensors
models/**/pytorch_model*.bin
models/**/optimizer.bin
models/**/scheduler.bin
models/**/*.pt
models/**/*.pth
models/**/*.gguf
models/**/checkpoint-*/
# Tokenizers can be regenerated with AutoTokenizer.from_pretrained(base_id).
# Excluded to save ~44 MB across the four v1..v4 model dirs.
models/**/tokenizer.json

# Data + heavy outputs are on Google Drive, not in this repo.
# See README "Data setup" for the link and extraction instructions.
data/
phase2_data/
phase2_data_liar/
outputs/

# Paper is kept out of the code repo for now.
project_report/

# HuggingFace / model caches
.cache/
hf_cache/
.huggingface/
~/.cache/

# Cloned reference repos (kept locally for inspection, not shipped)
wang2025a/
reference_repos/

# Local notes / drafts not for the repo
notes_local.md
scratch/
cleanup_phase_a.sh

# LaTeX build artifacts
project_report/*.aux
project_report/*.log
project_report/*.out
project_report/*.bbl
project_report/*.blg
project_report/*.toc
project_report/*.fls
project_report/*.fdb_latexmk
project_report/*.synctex.gz

# Things we DO track (kept for reproducibility):
#   - src/, scripts/, configs/, notebooks/
#   - README.md, requirements.txt
#   - models/*/*.json, *.log, README.md (weights on HF, tokenizer regenerable)
#   - eval_logs/ (training + OOD probe logs)
#   - fixtures/ (tiny CI test data)
